# ── Required ──────────────────────────────────────────────────
# ⚠️  If .env was ever pushed to a public repo, ROTATE ALL secrets immediately!
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Use a 64+ character random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET_KEY=CHANGE-ME-generate-a-64-char-random-string-see-command-above

# ── Deployment ────────────────────────────────────────────────
# PORT is auto-set by Render; default 4000 for local dev
PORT=4000

# APP_URL — where your FRONTEND lives (used for OAuth redirect URIs)
#   Local dev:  http://localhost:4000
#   Production: https://your-app.vercel.app
APP_URL=http://localhost:4000

# ALLOWED_ORIGINS — comma-separated origins for CORS
#   Local dev:  * (allow all)
#   Production: https://your-app.vercel.app
ALLOWED_ORIGINS=*

# ── Cloudinary (image hosting) ────────────────────────────────
# Get from: console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Optional: OAuth (only needed for Google/GitHub social login) ──
# Get from: console.developers.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Get from: github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

